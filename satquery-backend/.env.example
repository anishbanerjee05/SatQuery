# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VISION_MODEL=google/gemma-2-9b-it:free
OPENROUTER_VISION_MODEL_FALLBACK=microsoft/phi-3.5-vision-instruct:free
OPENROUTER_TEXT_MODEL=google/gemma-2-9b-it:free
OPENROUTER_TEXT_MODEL_FALLBACK=microsoft/phi-3.5-mini-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Object Storage (Cloudflare R2 or Supabase Storage - S3 compatible)
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_BUCKET=satquery-images
STORAGE_REGION=auto

# App
APP_HOST=0.0.0.0
APP_PORT=8000